# Quadkit Framework core environment configuration example.
#
# Copy to .env and adjust values for your deployment:
#   cp .env.example .env
#
# All variables are optional unless noted: every config value carries a
# code default, so an unset variable falls back to framework defaults.
#
# Critical secrets MUST be set in production:
#   * any value shown as <change-me-in-production>
#   * provider API keys (OpenAI, Anthropic, Google, ...) supplied through
#     your secrets manager or *_SECRET_NAME references

# ── quadkit ──
QK_DEBUG=false  # — (str)
QK_QUADKIT__APP_NAME=quadkit-app  # Application name (str)
QK_QUADKIT__DEBUG=false  # Enable debug mode. Also toggled by the DEBUG env var. (bool)
QK_QUADKIT__DISCOVERY__AUTO_DISCOVER=false  # — (bool)
QK_QUADKIT__DISCOVERY__DIRECTORIES=  # — (list[str])
QK_QUADKIT__DISCOVERY__DISABLED_MODULES=  # — (list[str])
QK_QUADKIT__DISCOVERY__ENABLED_MODULES=  # — (list[str])
QK_QUADKIT__DISCOVERY__ENTRY_POINT_GROUP=quadkit.modules  # — (str)
QK_QUADKIT__ENV=Environment.DEVELOPMENT  # Deployment environment (development, staging, production, test). (Environment)
QK_QUADKIT__HEALTH__CHECK_TIMEOUT=DEFAULT_HEALTH_CHECK_TIMEOUT  # — (float)
QK_QUADKIT__HEALTH__INCLUDE_DETAILS=true  # — (bool)
QK_QUADKIT__LOGGING__JSON_FORMAT=false  # JSON log format (bool)
QK_QUADKIT__LOGGING__LEVEL=INFO  # Global log level (str)
QK_QUADKIT__LOGGING__LEVELS=  # Per-logger level overrides (dict[str, str])
QK_QUADKIT__LOGGING__REDACTION__ENABLED=true  # — (bool)
QK_QUADKIT__LOGGING__REDACTION__FIELD_DENYLIST=  # — (tuple[str, ...])
QK_QUADKIT__LOGGING__SAMPLING__DEFAULT_RATE=1.0  # — (float)
QK_QUADKIT__LOGGING__SAMPLING__ENABLED=false  # — (bool)
QK_QUADKIT__LOGGING__SAMPLING__RULES=  # — (dict[str, float])
QK_QUADKIT__MODULES=  # Enabled modules (list[str])
QK_PROFILE=development  # — (str)
QK_QUIET=false  # — (str)
QK_SECURITY__HASHING__ALGORITHM=pbkdf2_sha256  # — (str)
QK_SECURITY__HASHING__BLAKE2B_DIGEST_SIZE=64  # — (int)
QK_SECURITY__HASHING__DEFAULT_HASHER=sha256  # — (str)
QK_SECURITY__HASHING__DKLEN=32  # — (int)
QK_SECURITY__HASHING__ITERATIONS=100000  # — (int)
QK_SECURITY__HASHING__SALT_LENGTH=16  # — (int)
QK_SECURITY__SANITIZATION__ALLOWED_TAGS=  # — (set[str] | None)
QK_SECURITY__SANITIZATION__DEFAULT_SANITIZE_MODE=allow  # — (str)
QK_SECURITY__SANITIZATION__STRIP_COMMENTS=true  # — (bool)
