"""{{ driver_name }}Driver — {{ driver_type }} storage backend.

Generated by ``quadkit gen storage_driver``.  The driver implements the
full :class:`~quadkit.storage.backends.AbstractDriver` contract with an
in-memory store, mirroring :class:`~quadkit.storage.backends.memory.MemoryDriver`.
Replace the in-memory operations with backend-specific calls (S3, GCS,
Azure, local disk) when integrating a real service.

Register it as a storage backend in ``application.yaml``::

    storage:
      backends:
        - name: {{ driver_name_snake }}
          type: {{ driver_name_snake }}
"""

from __future__ import annotations

from collections.abc import AsyncGenerator, AsyncIterator
from datetime import timedelta
from typing import Any, BinaryIO, cast

from quadkit import clock
from quadkit.contracts.core import HealthCheckResult, HealthStatus
from quadkit.contracts.infra.storage import (
    FileInfo,
    Uploadable,
    UploadOptions,
)
from quadkit.logging import get_logger
from quadkit.storage.backends import AbstractDriver as BaseDriver
from quadkit.storage.exceptions import (
    StorageFileNotFoundError,
    StorageUnsupportedOperationError,
)

logger = get_logger(__name__)


class {{ driver_name }}Driver(BaseDriver):
    """{{ driver_type }} storage with an in-memory fallback store."""

    def __init__(self) -> None:
        """Initialize the driver with an empty store."""
        self._storage: dict[str, dict[str, Any]] = {}

    async def upload(
        self,
        path: str,
        data: Uploadable,
        content_type: UploadOptions | str | None = None,
        **options: Any,
    ) -> FileInfo:
        """Store *data* at *path*.

        Args:
            path: Destination storage path / key.
            data: Bytes, text, a binary stream, or an async byte iterator.
            content_type: Optional MIME type override.
            **options: Additional upload options.

        Returns:
            :class:`FileInfo` describing the stored file.
        """
        if isinstance(content_type, UploadOptions):
            content_type = content_type.content_type
        content = await self._coerce_uploadable(data)
        now = clock.now()
        resolved_type = content_type or "application/octet-stream"
        metadata = options.get("metadata") or {}

        self._storage[path] = {
            "content": content,
            "size": len(content),
            "content_type": resolved_type,
            "last_modified": now,
            "metadata": metadata,
        }
        logger.info("storage_uploaded", path=path, size=len(content))
        return self._file_info(path)

    async def download(self, path: str) -> bytes:
        """Return the raw bytes stored at *path*.

        Args:
            path: Storage path / key.

        Returns:
            Stored file content.

        Raises:
            StorageFileNotFoundError: If the path is unknown.
        """
        return cast("bytes", self._find(path)["content"])

    async def stream(
        self,
        path: str,
        chunk_size: int = 8192,
    ) -> AsyncGenerator[bytes, None]:
        """Yield *chunk_size* byte chunks from *path*.

        Args:
            path: Storage path / key.
            chunk_size: Chunk size in bytes.

        Yields:
            Raw byte chunks.
        """
        content = await self.download(path)
        for start in range(0, len(content), chunk_size):
            yield content[start : start + chunk_size]

    async def delete(self, path: str) -> None:
        """Delete the file at *path*.

        Args:
            path: Storage path / key.

        Raises:
            StorageFileNotFoundError: If the path is unknown.
        """
        self._find(path)
        del self._storage[path]

    async def exists(self, path: str) -> bool:
        """Return ``True`` when *path* is stored."""
        return path in self._storage

    async def info(self, path: str) -> FileInfo:
        """Return metadata for *path*.

        Args:
            path: Storage path / key.

        Returns:
            :class:`FileInfo` for the stored file.
        """
        return self._file_info(path)

    async def list(self, prefix: str = "") -> AsyncGenerator[FileInfo, None]:
        """Yield :class:`FileInfo` for every key under *prefix*."""
        for path in sorted(self._storage):
            if path.startswith(prefix):
                yield self._file_info(path)

    async def get_url(self, path: str) -> str:
        """Return a driver-local URL for *path*."""
        return "{{ driver_type }}" + "://" + path

    async def get_presigned_url(
        self,
        path: str,
        expires_in: timedelta = timedelta(hours=1),
        method: str = "GET",
    ) -> str:
        """Raise — presigned URLs require a network-backed driver.

        Args:
            path: File path that would have been signed.
            expires_in: Ignored by this driver.
            method: Ignored by this driver.

        Raises:
            StorageUnsupportedOperationError: Always for this scaffold.
        """
        raise StorageUnsupportedOperationError(
            "Presigned URLs are not supported by this storage driver.",
            details={"path": path, "driver": "{{ driver_name_snake }}"},
            hint="Use a cloud-backed driver (S3, GCS, or Azure) to generate presigned URLs.",
        )

    async def health_check(self, timeout: float = 5.0) -> HealthCheckResult:
        """Report the driver's health with live store counters."""
        return HealthCheckResult(
            component="storage.{{ driver_name_snake }}",
            status=HealthStatus.HEALTHY,
            details={
                "driver": "{{ driver_name_snake }}",
                "file_count": len(self._storage),
                "total_size": sum(record["size"] for record in self._storage.values()),
            },
        )

    async def _coerce_uploadable(self, data: Uploadable) -> bytes:
        """Normalize any accepted upload form into raw bytes.

        Args:
            data: Bytes, text, a binary stream, or an async byte iterator.

        Returns:
            The raw byte content.
        """
        if isinstance(data, bytes):
            return data
        if isinstance(data, str):
            return data.encode("utf-8")
        if isinstance(data, bytearray):
            return bytes(data)
        if hasattr(data, "read"):
            return await self._read_binary(data)
        if isinstance(data, AsyncIterator):  # type: ignore[arg-type]
            return await self._read_iterator(data)
        raise ValueError(f"Unsupported upload data type: {type(data)}")

    async def _read_binary(self, stream: BinaryIO) -> bytes:
        """Read a binary stream into bytes."""
        raw = stream.read()
        if isinstance(raw, str):
            return raw.encode("utf-8")
        if isinstance(raw, bytearray):
            return bytes(raw)
        if isinstance(raw, bytes):
            return raw
        raise ValueError(f"Unsupported stream read() return type: {type(raw)}")

    async def _read_iterator(self, stream: AsyncIterator[bytes]) -> bytes:
        """Collect an async byte iterator into bytes."""
        chunks: list[bytes] = []
        async for chunk in stream:
            if isinstance(chunk, str):
                chunk = chunk.encode("utf-8")
            chunks.append(chunk)
        return b"".join(chunks)

    def _find(self, path: str) -> dict[str, Any]:
        """Return the stored record for *path*.

        Raises:
            StorageFileNotFoundError: If the path is unknown.
        """
        record = self._storage.get(path)
        if record is None:
            raise StorageFileNotFoundError(
                f"File not found: {path!r}",
                details={"path": path},
                hint="Verify the file exists before accessing it.",
            )
        return record

    def _file_info(self, path: str) -> FileInfo:
        """Build a :class:`FileInfo` from a stored record."""
        record = self._find(path)
        return FileInfo(
            path=path,
            size=record["size"],
            content_type=record["content_type"],
            last_modified=record["last_modified"],
            etag=f'"{hash(record["content"]):x}"',
            metadata=record["metadata"],
        )
