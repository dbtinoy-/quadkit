{% if guard_type == 'role' %}
class {{ guard_name }}RoleGuard(RoleGuard):
    """Role-based guard for {{ guard_name }}.

    Checks if the user has one of the required roles; override
    :meth:`can_activate` to add custom authorization logic.
    """

    def __init__(self, *roles: str) -> None:
        """Initialize the role guard.

        Args:
            roles: List of allowed roles.
        """
        super().__init__(*roles)
{% endif %}


# =============================================================================
# Permission Guard Variant
# =============================================================================

{% if guard_type == 'permission' %}
class {{ guard_name }}PermissionGuard(PermissionGuard):
    """Permission-based guard for {{ guard_name }}.

    Checks if the user has the required permissions; override
    :meth:`can_activate` to add custom authorization logic.
    """

    def __init__(
        self,
        *permissions: str,
        require_all: bool = True,
    ) -> None:
        """Initialize the permission guard.

        Args:
            permissions: List of required permissions.
            require_all: Require all permissions (default) or any of them.
        """
        super().__init__(*permissions, require_all=require_all)
{% endif %}


