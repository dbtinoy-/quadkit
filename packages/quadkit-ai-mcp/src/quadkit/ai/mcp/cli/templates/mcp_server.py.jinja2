if __name__ == "__main__":
    import asyncio
    import sys
    import types

    from quadkit.ai.mcp.controller import (
        ModulePromptProvider,
        ModuleResourceProvider,
        ModuleToolProvider,
    )
    from quadkit.ai.mcp.server import MCPServer
    from quadkit.ai.mcp.server.handlers import (
        PromptHandler,
        ResourceHandler,
        ToolHandler,
    )
    from quadkit.ai.mcp.transport import StdioTransport

    mod = types.ModuleType(__name__)
    mod.__dict__.update({k: v for k, v in globals().items() if not k.startswith("__")})

    server = MCPServer(
        name=__mcp_name__,
        version=__mcp_version__,
        tool_handler=ToolHandler(ModuleToolProvider.from_module(mod)),
        resource_handler=ResourceHandler(ModuleResourceProvider.from_module(mod)),
        prompt_handler=PromptHandler(ModulePromptProvider.from_module(mod)),
    )

    transport = StdioTransport()

    async def _main():
        await transport.connect(server)

    asyncio.run(_main())
