"""Convention followed: **Repository pattern** — a cache-aside
decorator: reads check the cache first, writes invalidate; the
wrapped repository stays the source of truth.

{{ entity_name }} repository with caching.

This module provides a cached repository that wraps an underlying data
repository and applies the cache-aside pattern:

1. On read   – return the cached value when present; fall back to the
               underlying repository on a cache miss and populate the cache.
2. On write  – delegate to the underlying repository, then invalidate the
               affected cache keys so stale data is never served.
"""

from __future__ import annotations

from dataclasses import asdict, dataclass

from quadkit.cache import CacheService
from quadkit.contracts.data import RepositoryProtocol


@dataclass
class {{ entity_name }}Entity:
    """Data model for the {{ entity_name }} domain object."""
