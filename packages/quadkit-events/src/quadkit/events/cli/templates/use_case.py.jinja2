{% if output_fields %}{% if has_uuid_outputs %}def _project_uuid(value: object) -> str:
    """Normalize typed UUIDs or canonical storage strings, never arbitrary coercion."""
    if type(value) is UUID:
        return str(value)
    if type(value) is not str or str(UUID(value)) != value:
        raise ValueError("invalid UUID output")
    return value


def _project_nullable_uuid(value: object) -> str | None:
    return None if value is None else _project_uuid(value)


{% endif %}{% if has_date_outputs %}def _project_date(value: object) -> str:
    """Project exact dates or canonical YYYY-MM-DD storage strings."""
    if type(value) is date:
        return value.isoformat()
    if type(value) is not str or date.fromisoformat(value).isoformat() != value:
        raise ValueError("invalid date output")
    return value


def _project_nullable_date(value: object) -> str | None:
    return None if value is None else _project_date(value)


{% endif %}{% if has_datetime_outputs %}def _project_datetime(value: object) -> str:
    """Normalize aware instants; reject naive, unknown offsets and precision loss."""
    if type(value) is str:
        match = _output_re.fullmatch(
            r"[0-9]{4}-[0-9]{2}-[0-9]{2}[T ][0-9]{2}:[0-9]{2}:[0-9]{2}"
            r"(?:\.[0-9]{1,6})?(?P<offset>Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9]"
            r"(?::[0-5][0-9](?:\.[0-9]{1,6})?)?)", value,
        )
        if match is None:
            raise ValueError("invalid datetime output")
        offset = match.group("offset")
        if offset.startswith("-") and all(char in "0:." for char in offset[1:]):
            raise ValueError("unknown datetime output offset")
        parsed = datetime.fromisoformat(value)
    elif type(value) is datetime:
        parsed = value
    else:
        raise ValueError("invalid datetime output")
    try:
        if parsed.utcoffset() is None:
            raise ValueError("naive datetime output")
        return parsed.astimezone(_output_utc).isoformat().removesuffix("+00:00") + "Z"
    except Exception as exc:
        # User-supplied tzinfo callbacks may fail; never persist an invalid projection.
        raise ValueError("invalid datetime output") from exc


def _project_nullable_datetime(value: object) -> str | None:
    return None if value is None else _project_datetime(value)


{% endif %}{% if has_time_outputs %}def _project_time(value: object) -> str:
    """Project local time without offsets, date inference, or fold loss."""
    if type(value) is str:
        if _output_re.fullmatch(
            r"(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\.[0-9]{1,6})?", value,
        ) is None:
            raise ValueError("invalid time output")
        parsed = time.fromisoformat(value)
    elif type(value) is time:
        parsed = value
    else:
        raise ValueError("invalid time output")
    if parsed.tzinfo is not None or parsed.fold != 0:
        raise ValueError("time output must be local and unambiguous")
    return parsed.isoformat()


def _project_nullable_time(value: object) -> str | None:
    return None if value is None else _project_time(value)


{% endif %}{% if has_json_outputs %}def _project_json(value: object, *, storage_text: bool = False) -> dict[str, Any]:
    """Validate before copying; retain JSON values, never Python-only coercions."""
    if not _is_strict_json_object(value, storage_text=storage_text):
        raise ValueError("invalid JSON object output")
    projected: dict[str, Any] = _json.loads(_json.dumps(value, allow_nan=False, ensure_ascii=False))
    return projected


def _project_nullable_json(value: object, *, storage_text: bool = False) -> dict[str, Any] | None:
    return None if value is None else _project_json(value, storage_text=storage_text)


