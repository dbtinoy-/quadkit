{% if related_write_checks %}
def _valid_related_write(
    value: object, kind: str, nullable: bool,
    min_length: int | None, max_length: int | None,
    minimum: int | float | None, maximum: int | float | None,
    options: tuple[str, ...] | None,
) -> bool:
    """No coercion; validate snapshots before any aggregate mutation."""
    if value is None:
        return nullable
    if type(value) is not {"str": str, "int": int, "float": float, "bool": bool}[kind]:
        return False
    if isinstance(value, str):
        if "\x00" in value:
            return False
        try:
            value.encode("utf-8")
        except UnicodeEncodeError:
            return False
        if min_length is not None and len(value) < min_length:
            return False
        if max_length is not None and len(value) > max_length:
            return False
        if options is not None and value not in options:
            return False
    if type(value) is float and not math.isfinite(value):
        return False
    if minimum is not None:
        if not isinstance(value, (int, float)) or isinstance(value, bool) or value < minimum:
            return False
    if maximum is not None:
        if not isinstance(value, (int, float)) or isinstance(value, bool) or value > maximum:
            return False
    return True

