def _principal_subject(principal: Any) -> str | None:
    """Extract the trusted principal's subject; do not trust a second claim."""
    if isinstance(principal, str):
        return principal or None
    if isinstance(principal, dict):
        value = principal.get("user_id") or principal.get("sub") or principal.get("subject")
    else:
        value = (
            getattr(principal, "user_id", None)
            or getattr(principal, "sub", None)
            or getattr(principal, "subject", None)
        )
    if not value or isinstance(value, (dict, list, tuple, set, bytes)):
        return None
    return str(value)
