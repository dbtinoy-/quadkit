{% if needs_sql_datetime %}
def _is_sql_datetime(value: datetime) -> bool:
    """Require an unambiguous instant inside the non-infinity UTC range."""
    try:
        if type(value) is not datetime or value.utcoffset() is None:
            return False
        normalized = value.astimezone(_sql_utc)
        return datetime.min.replace(tzinfo=_sql_utc) < normalized < datetime.max.replace(tzinfo=_sql_utc)
    except Exception:  # noqa: BLE001 -- arbitrary tzinfo implementations must fail closed
        # User-defined tzinfo can raise or overflow during UTC conversion.
        return False
{% endif %}
{% if json_checks or has_json_outputs %}
def _is_strict_json_object(value: Any, *, storage_text: bool = False) -> bool:
    """Check the full JSON tree without coercing Python-only values."""
    if type(value) is not dict:
        return False
    pending = [value]
    seen: set[int] = set()
    while pending:
        item = pending.pop()
        if type(item) is str:
            if storage_text and "\x00" in item:
                return False
            try:
                item.encode("utf-8")
            except UnicodeEncodeError:
                return False
        elif type(item) is dict:
            if id(item) in seen:
                continue
            seen.add(id(item))
            if any(type(key) is not str for key in item):
                return False
            pending.extend(item.keys())
            pending.extend(item.values())
        elif type(item) is list:
            if id(item) in seen:
                continue
            seen.add(id(item))
            pending.extend(item)
        elif item is not None and type(item) not in (bool, int, float):
            return False
    try:
        # Also rejects cycles, non-finite floats and values beyond the JSON
        # serializer's recursion or integer limits. Shared values are valid.
        _json.dumps(value, allow_nan=False)
    except (ValueError, TypeError, RecursionError, OverflowError, UnicodeError):
        return False
    return True
