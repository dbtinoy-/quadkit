class _{{ repo_name }}Inner(GenericRepository[{{ entity_name }}Entity, str]):
    """Row mapper bridge over the generic SQL repository."""

    def _serialize_entity(self, entity: {{ entity_name }}Entity) -> dict[str, Any]:
        """Row dict via the framework serializer (datetime/UUID/enum-safe)."""
        serialized = json_serialize(entity)
        if isinstance(serialized, dict):
{% if write_only_fields %}            for write_only in _WRITE_ONLY_FIELDS:
                serialized.pop(write_only, None)
{% endif %}            return serialized
        return {"value": serialized}

    def _row_to_entity(self, row: dict[str, Any]) -> {{ entity_name }}Entity:
{% if json_fields %}        data = dict(row)
        for json_field in _JSON_FIELDS:
            value = data.get(json_field)
            if isinstance(value, str):
                data[json_field] = _json.loads(value)
        return self.entity_class(**data){% else %}        return self.entity_class(**dict(row)){% endif %}


class {{ repo_name }}Repository:
    """Working CRUD repository for {{ resource_name }}.

    Backed by ``GenericRepository`` and the injected
    ``DatabaseProviderProtocol``; requires migrations to have created the
    ``{{ table_name }}`` table.
    """

    def __init__(self, provider: DatabaseProviderProtocol) -> None:
        self._provider = provider
        self._inner = _{{ repo_name }}Inner(
            provider=provider,
            table_name="{{ table_name }}",
            entity_class={{ entity_name }}Entity,
            key_field="{{ key_field }}",
        )

    def _prepare(self, data: dict[str, Any]) -> dict[str, Any]:
        row = dict(data)
        row.setdefault("{{ key_field }}", str(_uuid.uuid4()))
        now = clock.now().isoformat()
        row.setdefault("created_at", now)
        row["updated_at"] = now
        return row

    async def create(
        self, data: dict[str, Any]
    ) -> Result[{% if write_only_fields %}dict[str, Any]{% else %}{{ entity_name }}Entity{% endif %}, ConflictError | {% if has_foreign_keys %}ValidationError | {% endif %}{{ not_found_error }}]:
        """Insert a row, mapping integrity outcomes to domain errors.

        A CRUD surface has one return shape: the new row travels as
        ``Ok(entity)`` like every sibling verb (R6). Expected integrity
        outcomes travel the same way — a missing reference is a 422
        ``ValidationError``, a unique/constraint collision a 409
        ``ConflictError`` — instead of surfacing as unhandled 500s.
        Harder faults stay on the throw path.{% if write_only_fields %} The entity
        has write-only fields, so the created row travels as its serialized
        public shape: a write-only value never travels back out.{% endif %}"""
        row = self._prepare(data)
        try:
            await self._provider.execute_insert("{{ table_name }}", row)
        except {% if has_foreign_keys %}ForeignKeyError:
            return Err(_reference_error(row))
        except {% endif %}DuplicateKeyError:
            return Err(
                ConflictError("{{ entity_name }} violates a unique constraint")
            )
        except IntegrityError:
            return Err(
                ConflictError("{{ entity_name }} violates a database constraint")
            )
        found = await self._inner.find_by_id(row["{{ key_field }}"])
        if found is None:
            raise RuntimeError(
                "Insert succeeded but fetch failed for {{ table_name }}:"
                + str(row["{{ key_field }}"])
            )
        return Ok({% if write_only_fields %}self._inner._serialize_entity(found){% else %}found{% endif %})

    async def get(self, key: str) -> Result[dict[str, Any], {{ not_found_error }}]:
        """A row that is not there is an expected outcome: absence travels
        as ``Err({{ not_found_error }})`` — a value — never as ``None`` (R6)."""
        entity = await self._inner.find_by_id(key)
        if entity is None:
            return Err(
                {{ not_found_error }}(f"{{ entity_name }} not found with id: {key}")
            )
        return Ok(self._inner._serialize_entity(entity))

    async def list(
        self, limit: int = 50
    ) -> Result[list[dict[str, Any]], {{ not_found_error }}]:
        """An empty page is a value, and it travels as ``Ok([])``: list joins
        the Result surface so callers never special-case one verb (R6)."""
        entities = await self._inner.find(limit=limit)
        return Ok([self._inner._serialize_entity(e) for e in entities])

    async def update(
        self, key: str, data: dict[str, Any]
    ) -> Result[dict[str, Any], ConflictError | {% if has_foreign_keys %}ValidationError | {% endif %}{{ not_found_error }}]:
        existing = await self._inner.find_by_id(key)
        if existing is None:
            return Err(
                {{ not_found_error }}(f"{{ entity_name }} not found with id: {key}")
            )
        try:
            async with self._provider.transaction():
                row = {
                    **data,
                    "{{ key_field }}": key,
                    "updated_at": clock.now().isoformat(),
                }
                await self._provider.execute_update(
                    "{{ table_name }}", row, '"{{ key_field }}" = ?', [key]
                )
        except {% if has_foreign_keys %}ForeignKeyError:
            return Err(_reference_error(data))
        except {% endif %}DuplicateKeyError:
            return Err(
                ConflictError("{{ entity_name }} violates a unique constraint")
            )
        except IntegrityError:
            return Err(
                ConflictError("{{ entity_name }} violates a database constraint")
            )
        # Rebox the read outcome into this method's wider error union. Result
        # is invariant; returning get() directly would narrow the error type.
        result = await self.get(key)
        if result.is_err():
            return Err(result.unwrap_err())
        return Ok(result.unwrap())

    async def delete(self, key: str) -> Result[bool, ConflictError | {{ not_found_error }}]:
        """Deleting a row that is not there is an expected outcome, so it
        travels as ``Err({{ not_found_error }})`` — one named error type for the
        outcome, defined once, instead of a truthiness every caller must
        re-read (R6). A delete other rows restrict is likewise expected:
        it travels as ``Err(ConflictError)`` (409). Harder faults (a dead
        connection) stay on the throw path."""
        try:
            removed = await self._inner.delete_by_id(key)
        except ForeignKeyError:
            return Err(
                ConflictError(
                    f"{{ entity_name }} {key} is still referenced by other rows"
                )
            )
        except IntegrityError:
            return Err(
                ConflictError("{{ entity_name }} violates a database constraint")
            )
        if not removed:
            return Err(
                {{ not_found_error }}(f"{{ entity_name }} not found with id: {key}")
            )
        return Ok(True)
