#: Physical foreign keys: field name -> ``"<table>.<column>"`` target.
_FOREIGN_KEYS = {
{% for fk in foreign_keys %}    "{{ fk.field }}": "{{ fk.target }}",
{% endfor %}}


def _reference_error(data: dict[str, Any]) -> ValidationError:
    """The 422 a create/update answers when a referenced row is missing.

    The database reports *that* a foreign key failed, not which one; the
    offending field is named only when exactly one foreign-key field in
    the payload is non-null, so the identification is always exact.
    """
    named = [name for name in _FOREIGN_KEYS if data.get(name) is not None]
    if len(named) == 1:
        field = named[0]
        return ValidationError(
            "{{ entity_name }} references a row that does not exist",
            errors=[
                FieldError(
                    field,
                    f"references a missing {_FOREIGN_KEYS[field]} row",
                    code="reference_missing",
                )
            ],
        )
    return ValidationError("{{ entity_name }} references a row that does not exist")
{% endif %}{% if write_only_fields %}
#: Write-only fields: accepted on write, stripped from every serialized row.
_WRITE_ONLY_FIELDS = frozenset([{% for name in write_only_fields %}"{{ name }}"{% if not loop.last %}, {% endif %}{% endfor %}])
{% endif %}{% if json_fields %}
#: JSON columns: stored as JSON text (the providers encode dict/list
#: values on write), hydrated back to values on read.
_JSON_FIELDS = frozenset([{% for name in json_fields %}"{{ name }}"{% if not loop.last %}, {% endif %}{% endfor %}])
{% endif %}

