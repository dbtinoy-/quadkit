"""Database seeder for {{ model_name }}."""

from __future__ import annotations

from datetime import datetime, timezone
from typing import Any

from quadkit.contracts import DatabaseProviderProtocol
from quadkit.sql import SimpleUnitOfWork


SEED_DATA: list[dict[str, Any]] = [
    {
        {%- for field in fields %}
        "{{ field.name }}": {{ field.sample_value }},
        {%- endfor %}
        "created_at": datetime.now(timezone.utc),
        "updated_at": datetime.now(timezone.utc),
    },
]


class {{ model_name }}Entity:
    """Row entity for the ``{{ table_name }}`` table."""

    __table_name__ = "{{ table_name }}"

    def __init__(self, **data: Any) -> None:
        """Populate row attributes from *data*."""
        for key, value in data.items():
            setattr(self, key, value)


async def run(provider: DatabaseProviderProtocol) -> None:
    """Insert seed data idempotently.

    Args:
        provider: Database provider used to execute the seed transaction.
    """
    result = await provider.execute_query(
        "SELECT COUNT(*) AS count FROM {{ table_name }}",
    )
    if result.rows and result.rows[0].get("count", 0) > 0:
        return

    async with SimpleUnitOfWork(provider) as uow:
        for data in SEED_DATA:
            uow.register_new({{ model_name }}Entity(**data))
        await uow.commit()
