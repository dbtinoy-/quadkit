    # =========================================================================
    # Helper Methods
    # =========================================================================

    async def _request(
        self,
        method: str,
        endpoint: str,
        **kwargs: Any,
    ) -> Result[HttpResponse, {{ client_name }}APIError]:
        """Make an HTTP request, answering the outcome as one Result.

        Args:
            method: HTTP method (GET, POST, PUT, PATCH, DELETE).
            endpoint: API endpoint path (relative to ``base_url``).
            **kwargs: Additional arguments forwarded to the HTTP client.

        Returns:
            ``Ok(response)`` on a passing status, ``Err(APIError)`` on a
            client/server failure or a transport exception — never raised,
            so consumers compose with .map_sync / .map_err instead of try/except.
        """
        try:
            response = await self._client.request(method, endpoint, **kwargs)
        except Exception as exc:  # noqa: BLE001
            logger.exception("{{ client_name_snake }}_request_error", method=method)
            return Err(
                {{ client_name }}APIError(
                    message=f"Request failed: {exc}",
                    status_code=None,
                    response=None,
                )
            )
        if response.status >= 400:
            return Err(
                {{ client_name }}APIError(
                    message=f"API request failed: {response.status}",
                    status_code=response.status,
                    response=response,
                )
            )
        return Ok(response)


class {{ client_name }}APIError(Exception):
    """The {{ client_name }} API failure outcome as a value.

    Carried in ``Err`` (R6) — callers compose instead of try/except. It
    subclasses ``Exception`` only so a consumer MAY escalate it across an
    outer infrastructure boundary unchanged.
    """

    def __init__(
        self,
        message: str,
        status_code: int | None,
        response: HttpResponse | None,
    ) -> None:
        """Initialize the error.

        Args:
            message: Error message.
            status_code: HTTP status code.
            response: The response object if available.
        """
        super().__init__(message)
        self.message = message
        self.status_code = status_code
        self.response = response


