    timeout: float = 30.0,
) -> {{ client_name }}Client:
    """Create a {{ client_name }} client instance.

    This function can be used with Quadkit's dependency injection.

    Args:
        base_url: Base URL for the API.
        api_key: Optional API key.
        timeout: Request timeout.

    Returns:
        Configured {{ client_name }}Client instance.
    """
    return {{ client_name }}Client(
        base_url=base_url,
        api_key=api_key,
        timeout=timeout,
    )
