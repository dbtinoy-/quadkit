"""{{ class_name }} error.

{% if doc %}
{{ doc }}
{% endif %}
HTTP error raised by the {{ class_name }} domain.
"""
from __future__ import annotations

from quadkit.web.exceptions import HTTPError


class {{ class_name }}Error(HTTPError):
    """{{ status_code }} error for {{ class_name }} failures.

    Raise it from controllers/handlers (or return it from services) and let
    the built-in exception pipeline turn it into an RFC 7807 response; pair
    with a custom :class:`quadkit.contracts.web.ExceptionFilterProtocol`
    implementation for tailored handling.
    """

    _code: str = "{{ error_code }}"

    def __init__(
        self,
        detail: str = "{{ class_name }} error",
        cause: Exception | None = None,
    ) -> None:
        """Initialize the error.

        Args:
            detail: Human-readable error detail.
            cause: Original exception that triggered this error.
        """
        super().__init__(
            status_code={{ status_code }},
            detail=detail,
            code="{{ code }}",
            cause=cause,
        )


# =============================================================================
# Usage
# =============================================================================
#
# raise {{ class_name }}Error("Payment was declined")
#
# # Caught by the default exception pipeline → {{ status_code }} JSON response
