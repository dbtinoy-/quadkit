class Invalid{{ class_name }}Error(DomainError):
    """The request body is not a usable {{ class_name }}.

    Request-shape fault — malformed JSON or failed DTO validation — not a
    domain rule. ``DomainError`` answers 400 by default, so no
    ``ResultResponseMapper.register`` call is needed.
    """

{% endif %}
