"""Convention followed: **Controller pattern** — stateless HTTP adapters;
handlers stay thin: parse the request, delegate to ``self.repo``,
serialize the answer. Every handler returns ``Result[T, E]``
(Convention: **Result + ProblemDetail**): the repository returns blocked
outcomes as ``Err`` values (R6: absence is a value, never ``None``), the
controller maps the ``Ok`` arm through to a body, and the Result bridge
renders any ``Err`` as RFC-9457 ``ProblemDetail``. A handler never probes
a call result (``is None``, truthiness) — one representation per outcome.
Even the infallible ``list`` is Result-shaped (its envelope is ``Ok(...)``)
so one HTTP verb set has exactly one return shape.

{{ class_name }} controller module.
{% if doc %}
{{ doc }}
{% endif %}
Scaffold: endpoints delegate to ``self.repo`` — wire a repository with
CRUD methods ({{ ops_enabled | join('/') }}) in your DI provider.
{% if ops['create'] or ops['update'] %}
Request bodies are validated through the generated Pydantic DTOs
(``{{ class_name }}Create`` / ``{{ class_name }}Update``) so field types and
required-ness are enforced before the repository sees them; a body that
is malformed or fails validation answers 400 as
``Err(Invalid{{ class_name }}Error)``.
{% endif %}"""
from __future__ import annotations

from typing import Any

from quadkit.serialization.domain import json_serialize
{% if write_ops %}from pydantic import ValidationError
from starlette.requests import Request
{% endif %}{% if contract_errors %}from quadkit.contracts.exceptions import {{ contract_errors | join(', ') }}
{% endif %}{% if needs_result %}from quadkit.result import Err, Ok, Result
{% endif %}from quadkit.web import Controller{% if ops['create'] %}, post{% endif %}{% if ops['list'] or ops['get'] %}, get{% endif %}{% if ops['update'] %}, put{% endif %}{% if ops['delete'] %}, delete{% endif %}
# resolves against the app source root (src/{{ repository_module }} by default)
{% if write_ops %}from {{ models_module }}.{{ model_name }} import {{ class_name }}Create, {{ class_name }}Update
{% endif %}from {{ repository_module }}.{{ model_name }}_repository import {{ class_name }}Repository

{% if write_ops %}
class Invalid{{ class_name }}Error(DomainError):
    """The request body is not a usable {{ class_name }}.

    Request-shape fault — malformed JSON or failed DTO validation — not a
    domain rule. ``DomainError`` answers 400 by default, so no
    ``ResultResponseMapper.register`` call is needed.
    """

{% endif %}
{% if write_ops %}

async def _read_body(request: Request) -> Result[dict[str, Any], Invalid{{ class_name }}Error]:
    """Parse the JSON request body, or the 400 problem as ``Err``."""
    try:
        data: Any = await request.json()
    except Exception:
        return Err(Invalid{{ class_name }}Error("Invalid JSON body"))
    if not isinstance(data, dict) or not data:
        return Err(Invalid{{ class_name }}Error("Request body must be a non-empty JSON object"))
    return Ok(data)
{% endif %}

class {{ class_name }}Controller(Controller):
    """Controller for {{ class_name }} CRUD operations."""

    def __init__(self, repo: {{ class_name }}Repository) -> None:
        super().__init__()
        self.repo = repo
{% if ops['list'] %}
    @get("/{{ resource_path }}")
    async def list(
        self,
        limit: int = 20,
    ) -> Result[dict[str, Any], NotFoundError]:
        items = await self.repo.list(limit=limit)
        return Ok({
            "items": [json_serialize(item) for item in items],
            "limit": limit,
        })
{% endif %}{% if ops['get'] %}
    @get("/{{ resource_path }}/{item_id}")
    async def get(self, item_id: str) -> Result[dict[str, Any], NotFoundError]:
        item = await self.repo.get(item_id)
        return item.map(json_serialize)
{% endif %}{% if ops['create'] %}
    @post("/{{ resource_path }}", status_code=201)
    async def create(self, request: Request) -> Result[dict[str, Any], Invalid{{ class_name }}Error]:
        body = await _read_body(request)
        if body.is_err():
            return body
        try:
            payload = {{ class_name }}Create(**body.unwrap())
        except ValidationError as exc:
            return Err(
                Invalid{{ class_name }}Error(f"Invalid {{ class_name }} payload: {exc}")
            )
        created = await self.repo.create(payload.model_dump(mode="json"))
        return Ok(json_serialize(created))
{% endif %}{% if ops['update'] %}
    @put("/{{ resource_path }}/{item_id}")
    async def update(
        self,
        item_id: str,
        request: Request,
    ) -> Result[dict[str, Any], Invalid{{ class_name }}Error | NotFoundError]:
        body = await _read_body(request)
        if body.is_err():
            return body
        try:
            payload = {{ class_name }}Update(**body.unwrap())
        except ValidationError as exc:
            return Err(
                Invalid{{ class_name }}Error(f"Invalid {{ class_name }} payload: {exc}")
            )
        updated = await self.repo.update(
            item_id,
            payload.model_dump(mode="json", exclude_unset=True),
        )
        return updated.map(json_serialize)
{% endif %}{% if ops['delete'] %}
    @delete("/{{ resource_path }}/{item_id}")
    async def delete(self, item_id: str) -> Result[dict[str, str], NotFoundError]:
        deleted = await self.repo.delete(item_id)
        return deleted.map(lambda _done: {"message": "{{ class_name }} deleted"})
{%- endif %}
