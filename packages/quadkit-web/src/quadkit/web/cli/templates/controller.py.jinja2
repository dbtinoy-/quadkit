            payload = {{ class_name }}Create(**body.unwrap())
        except ValidationError as exc:
            return Err(
                Invalid{{ class_name }}Error(f"Invalid {{ class_name }} payload: {exc}")
            )
{% if validator_module or principal_fields %}        data = payload.model_dump(mode="json")
{% if validator_module %}        problems = {{ validator_function }}(data)
        if problems:
