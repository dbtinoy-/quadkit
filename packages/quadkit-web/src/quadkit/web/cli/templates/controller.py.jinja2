async def _read_body(request: Request) -> Result[dict[str, Any], Invalid{{ class_name }}Error]:
    """Parse the JSON request body, or the 400 problem as ``Err``."""
    try:
        data: Any = await request.json()
    except Exception:
        return Err(Invalid{{ class_name }}Error("Invalid JSON body"))
    if not isinstance(data, dict) or not data:
        return Err(Invalid{{ class_name }}Error("Request body must be a non-empty JSON object"))
    return Ok(data)
{% endif %}{% if principal_fields %}

def _principal_subject(request: Request) -> str | None:
    """The authenticated subject for ownership fields, or ``None``.

    The framework auth surface puts the current user on
    ``request.state.user`` and the subject id itself on
    ``request.state.user_id``. The user value's shape depends on the
    authenticator in play — a stored-record dict, a user object, or
    bare JWT claims — so the subject is read defensively in that
    order and a container is never stringified. ``None`` means no
    subject could be read; a principal-assigned create must then
    fail closed rather than guess an owner.
    """
    state = request.state
    slot = getattr(state, "user_id", None)
    if slot is not None and not isinstance(slot, (dict, list, tuple, set, bytes)) and slot:
        return str(slot)
    user = getattr(state, "user", None)
    if user is None:
        return None
    if isinstance(user, str):
        return user or None
    if isinstance(user, dict):
        value = user.get("user_id") or user.get("sub") or user.get("subject")
    else:
        value = (
            getattr(user, "user_id", None)
            or getattr(user, "sub", None)
            or getattr(user, "subject", None)
        )
    if value is None or isinstance(value, (dict, list, tuple, set, bytes)) or not value:
        return None
    return str(value)
{% endif %}

class {{ class_name }}Controller(Controller):
    """Controller for {{ class_name }} CRUD operations."""

    def __init__(self, repo: {{ class_name }}Repository) -> None:
        super().__init__()
        self.repo = repo
{% if ops['list'] %}
    @get("/{{ resource_path }}", response_schema_model=CrudCollectionResponse[{{ class_name }}], responses=ValidationErrorFilter.default_documented_responses(), result_errors=[{{ result_errors['list'] | join(', ') }}])
    async def list(
        self,
        limit: int = query(default=20),
    ) -> Result[dict[str, Any], NotFoundError]:
        items = await self.repo.list(limit=limit)
        return items.map_sync(
            lambda rows: {
                "items": [{{ '_serialize_row' if datetime_fields else 'json_serialize' }}(item) for item in rows],
                "limit": limit,
            }
        )
{% endif %}{% if ops['get'] %}
    @get("/{{ resource_path }}/{item_id}", response_schema_model={{ class_name }}, result_errors=[{{ result_errors['get'] | join(', ') }}])
    async def get(self, item_id: str) -> Result[dict[str, Any], NotFoundError]:
        item = await self.repo.get(item_id)
        return item.map_sync({{ '_serialize_row' if datetime_fields else 'json_serialize' }})
{% endif %}{% if ops['create'] %}
    @post("/{{ resource_path }}", status_code=201, request_model={{ class_name }}Create, response_schema_model={{ class_name }}, result_errors=[{{ result_errors['create'] | join(', ') }}])
    async def create(self, request: Request) -> Result[dict[str, Any], Invalid{{ class_name }}Error{% if principal_fields %} | AuthenticationError{% endif %} | ConflictError | DomainValidationError | NotFoundError]:
        body = await _read_body(request)
        if body.is_err():
            return Err(body.unwrap_err())
