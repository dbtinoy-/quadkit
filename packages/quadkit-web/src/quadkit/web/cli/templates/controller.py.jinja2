                DomainValidationError(
                    "Invalid {{ class_name }} payload",
                    errors=[
                        FieldError(field, message, code="validator_rule")
                        for field, message in problems.items()
                    ],
                )
            )
{% endif %}{% if principal_fields %}        subject = _principal_subject(request)
        if subject is None:
            return Err(
                AuthenticationError(
                    "Creating a {{ class_name }} requires an authenticated principal"
                )
            )
{% for field in principal_fields %}        data["{{ field }}"] = subject
{% endfor %}{% endif %}        created = await self.repo.create(data)
{% else %}        created = await self.repo.create(payload.model_dump(mode="json"))
{% endif %}        # Rebox the narrow repository Result into the handler's wider error union.
        if created.is_err():
            return Err(created.unwrap_err())
        return Ok({{ '_serialize_row' if datetime_fields else 'json_serialize' }}(created.unwrap()))
{% endif %}{% if ops['update'] %}
