logger = logging.getLogger(__name__)

#: Signature header, named once. Requests reach ASGI transports with their
#: header names lower-cased, so a lookup has to be case-insensitive rather
#: than assume the casing a sender used.
SIGNATURE_HEADER = "x-webhook-signature"


def _header(headers: Mapping[str, str], name: str) -> str | None:
    """Read *name* from *headers*, ignoring case.

    ``headers.get(name)`` alone is not enough: the mapping is whatever the
    caller built, and the same header can arrive as ``X-Webhook-Signature``,
    ``x-webhook-signature`` or any other case. Returning ``None`` for a header
    that *is* present would reject a correctly-signed request, so this scans.
    """
    for key, value in headers.items():
        if key.lower() == name:
            return value
    return None


