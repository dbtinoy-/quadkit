class {{ webhook_name }}Webhook:
    """Webhook handler for {{ webhook_name }}.

    This handler processes incoming webhook requests, verifies signatures,
    and dispatches events to appropriate handlers.
    """

    def __init__(
        self,
        secret: str | None = None,
        verify_signature: bool = True,
    ):
        """Initialize the webhook handler.

        Args:
            secret: Secret key for signature verification.
            verify_signature: Whether to verify webhook signatures.
        """
        self.secret = secret
        self.verify_signature = verify_signature
        self._handlers: dict[str, Any] = {}

    def register_handler(self, event_type: str, handler: Any) -> None:
        """Register a handler for a specific event type.

        Args:
            event_type: The type of event to handle.
            handler: Async function to handle the event.
        """
        self._handlers[event_type] = handler
        logger.debug("Registered handler for %s", event_type)

    async def handle_request(
        self,
        payload: bytes,
        headers: dict[str, str],
    ) -> dict[str, Any]:
        """Handle an incoming webhook request.

        Args:
            payload: Raw request body.
            headers: Request headers.

        Returns:
            Response dictionary.
        """
        try:
            if self.verify_signature:
                if not self.secret:
                    return {
                        "status": "error",
                        "message": "Webhook secret is not configured",
                    }

                signature = _header(headers, SIGNATURE_HEADER)
                if not signature:
                    return {
                        "status": "error",
                        "message": "Missing signature",
                    }

                if not self._verify_signature(payload, signature):
                    return {
                        "status": "error",
                        "message": "Invalid signature",
                    }

            data = loads(payload)
            webhook_payload = {{ webhook_name }}Payload(**data)
            event_type = webhook_payload.event_type
            handler = self._handlers.get(event_type)

            if handler:
                result = await handler(webhook_payload)
                return {
                    "status": "success",
                    "event_type": event_type,
                    "result": result,
                }

            logger.warning("No handler for event type: %s", event_type)
            return {
                "status": "ignored",
                "event_type": event_type,
                "message": "No handler registered",
            }
        except JSONDecodeError as exc:
            logger.error("Invalid JSON: %s", exc)
            return {
                "status": "error",
                "message": f"Invalid JSON: {exc}",
            }
        except Exception as exc:
            logger.exception("Error handling webhook")
            return {
                "status": "error",
                "message": str(exc),
            }

    def _verify_signature(self, payload: bytes, signature: str) -> bool:
        """Verify the webhook signature.

        Args:
            payload: Raw request body.
            signature: Provided signature.

        Returns:
            True if signature is valid.
        """
        if not self.secret:
            return True

        expected = hmac.new(
            self.secret.encode("utf-8"),
            payload,
            hashlib.sha256,
        ).hexdigest()

        return hmac.compare_digest(expected, signature)

