async def {{ webhook_name_snake }}_webhook_handler(request: Request) -> JSONResponse:
    """ASGI handler for {{ webhook_name }} webhooks.

    This can be used as a route handler in your application.

    Domain rules above this function should return ``Result[T, E]``; the
    webhook handler is the transport boundary, so its job is to turn the
    outcome into a response object. The response is quadkit's
    ``FastJSONResponse`` — datetime/UUID/dataclass values serialize
    natively through ``quadkit.serialization``.

    Args:
        request: The ASGI request.

    Returns:
        JSON response.
    """
    body = await request.body()
    headers = dict(request.headers)

    webhook = {{ webhook_name }}Webhook(
        secret=os.getenv("WEBHOOK_{{ webhook_name_snake | upper }}_SECRET"),
        verify_signature=True,
    )

    # Register handlers.
    # webhook.register_handler("payment.created", handle_payment)

    result = await webhook.handle_request(body, headers)
    return JSONResponse(result)
