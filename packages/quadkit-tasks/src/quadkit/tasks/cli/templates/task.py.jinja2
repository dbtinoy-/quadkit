@injectable
class {{ class_name }}TaskRunner:
    """Task runner for {{ class_name }} operations.

    Provides a convenient way to enqueue {{ task_name }} tasks through the
    injected :class:`~quadkit.tasks.TaskProvider`.
    """

    def __init__(self, provider: TaskProvider) -> None:
        """Initialize the task runner.

        Args:
            provider: Task provider used to enqueue jobs.
        """
        self._provider = provider

    @property
    def logger(self) -> Any:
        """Return the module logger."""
        return logger

    async def run(
        self,
{% for param in params %}        {{ param.name }}: {{ param.type }} = {{ param.default }},
{% endfor %}    ) -> str:
        """Run the {{ task_name }} task.

        Args:
{% for param in params %}            {{ param.name }}: {{ param.description or 'The ' + param.name }}
{% endfor %}
        Returns:
            Job ID for tracking.
        """
        task_kwargs: dict[str, Any] = {
{% for param in params %}            "{{ param.name }}": {{ param.name }},
{% endfor %}        }

        logger.info("{{ resource_name }}_dispatch", task_kwargs=task_kwargs)

        job = JobProtocol(
            id=uuid4().hex,
            name="{{ resource_name }}",
            args=(),
            kwargs=task_kwargs,
        )
        job_id = await self._provider.enqueue_job(job)

        logger.info("{{ resource_name }}_dispatched", job_id=job_id)
        return job_id
